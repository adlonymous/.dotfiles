{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "styles": {
        "opencode": {
          "metadataFormat": "$model$join_sep($thinking)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model$join_sep($thinking)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "formats": {
            "bottomLeft": "$session_name$join_sep($git_branch)"
          },
          "pathDisplay": "compact",
          "contextFormat": "percent-total",
          "contextGauge": false,
          "showSessionName": false,
          "showTimer": false,
          "showCost": true,
          "showCacheHit": false,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "separator": "dash"
        }
      },
      "codexQuota": false,
      "colorSource": "terminal",
      "borderColorMode": "static",
      "modelLabel": "id",
      "viewportIndicators": true
    },
    "userMessages": {
      "enabled": true,
      "style": "labeled",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      },
      "rail": "▌",
      "asciiRail": "▌"
    },
    "toolDisplay": {
      "enabled": true,
      "style": "opencode",
      "readOutputMode": "preview",
      "searchOutputMode": "preview",
      "previewLines": 3,
      "bashCollapsedLines": 3,
      "diffCollapsedLines": 8,
      "builtinRendererOverrides": {
        "bash": true
      }
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "turnSummaryFormat": "Turn took $turn_duration$join_sep(thought for $thought_duration)$join_sep(↑$input_tokens ↓$output_tokens)$join_sep$token_rate",
      "spinner": "star-bloom",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": false,
      "textIntervalMs": 60,
      "textAnimation": "classic",
      "placement": "border",
      "colorSource": "terminal",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tokenRate": true,
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "footer": {
      "style": "starship",
      "codexQuota": true,
      "styles": {
        "starship": {
          "format": "$cwd$join_sep($git_branch)$fill($codex_quota)",
          "compactFormat": "$cwd$join_sep($git_branch)$wrap($codex_quota)",
          "compactMaxLines": 2,
          "responsive": true,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": true,
            "modelInfo": false,
            "context": true,
            "tokens": true,
            "cost": true,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {},
            "colorModes": {}
          }
        }
      },
      "colorSource": "terminal",
      "modelLabel": "id"
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    }
  },
  "icons": {
    "mode": "nerd"
  }
}
